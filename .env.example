# انسخ هذا الملف إلى .env وعدّل القيم (لا ترفع .env إلى GitHub)
PORT=3000
NODE_ENV=production
# مجلد قاعدة البيانات — يجب أن يكون على قرص دائم في الاستضافة
DATA_DIR=./data
# حساب مدير المتجر الأول (يُنشأ مرة واحدة عند أول تشغيل)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
# مفتاح توقيع الجلسات — نص عشوائي طويل (48 حرفاً أو أكثر)
SESSION_SECRET=
# true = إضافة 12 منتجاً تجريبياً من النسخة القديمة عند قاعدة بيانات فارغة
SEED_SAMPLE_PRODUCTS=false
